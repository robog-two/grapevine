# Postgres connection strings
# For Vercel Postgres, prefer POSTGRES_PRISMA_URL for serverless (automatically set by Vercel)
# DATABASE_URL works for local development and other providers
DATABASE_URL=postgres://user:password@host:5432/personal_crm
# For Vercel migrations, use DATABASE_URL_UNPOOLED (automatically set by Vercel)
# DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/personal_crm

# Vercel Blob storage token (automatically set by Vercel when Storage is configured)
BLOB_READ_WRITE_TOKEN=

# 32+ byte random secret used to encrypt the session cookie (iron-session).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# 32-byte base64 server master key. Used ONLY to decrypt just enough of a
# user's data to build their one-way iCal reminders feed, since that route is
# polled by external calendar apps with no logged-in session attached.
# Generate with: openssl rand -base64 32
SERVER_MASTER_KEY=

# Base URL of the deployed app, used to build absolute links (share links, iCal feed).
APP_URL=http://localhost:3000
